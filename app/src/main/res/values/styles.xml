<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ================= STATIC ================= -->

    <style name="Medium">
        <item name="android:fontFamily">@font/ys_display_medium</item>
    </style>

    <style name="Regular">
        <item name="android:fontFamily">@font/ys_display_regular</item>
    </style>


    <style name="Medium.22">
        <item name="android:textSize">22sp</item>
    </style>

    <style name="Medium.19">
        <item name="android:textSize">19sp</item>
    </style>

    <style name="Medium.14">
        <item name="android:textSize">14sp</item>
    </style>

    <style name="Regular.16">
        <item name="android:textSize">16sp</item>
    </style>

    <style name="Regular.13">
        <item name="android:textSize">13sp</item>
    </style>

    <style name="Regular.11">
        <item name="android:textSize">11sp</item>
    </style>


    <style name="MainButton">
        <item name="android:backgroundTint">@color/yp_white</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
        <item name="android:insetTop">@dimen/button_inset</item>
        <item name="android:insetBottom">@dimen/button_inset</item>
        <item name="android:outlineSpotShadowColor">@android:color/transparent</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textAppearance">@style/Medium.22</item>
        <item name="android:textColor">@color/yp_black</item>

        <item name="cornerRadius">16dp</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">8dp</item>
        <item name="iconSize">24dp</item>
        <item name="iconTint">@color/yp_black</item>
    </style>

    <style name="Placeholder">
        <item name="android:drawablePadding">16dp</item>
        <item name="android:fontFamily">@font/ys_display_medium</item>
        <item name="android:textSize">19sp</item>
    </style>

        <style name="LeftColumnItem" parent="Regular.13">
            <item name="android:textColor">@color/yp_text_gray</item>
            <item name="android:gravity">center|start</item>
            <item name="layout_constraintHorizontal_weight">50</item>
        </style>

        <style name="RightColumnItem" parent="Regular.13">
            <item name="android:gravity">end</item>
            <item name="layout_constraintHorizontal_weight">50</item>
            <item name="android:paddingTop">8dp</item>
            <item name="android:paddingBottom">8dp</item>
        </style>

    <!-- ========================================== -->

    <style name="Toolbar">
        <item name="titleTextAppearance">@style/Medium.22</item>
        <item name="navigationIconTint">@color/yp_black</item>
    </style>

    <style name="Item" parent="Regular.16">
        <item name="android:textColor">@color/yp_black</item>
        <item name="android:gravity">center|start</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingHorizontal">@dimen/margin_horizontal</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>

        <item name="backgroundTint">@color/yp_white</item>
        <item name="cornerRadius">0dp</item>
        <item name="iconGravity">end</item>
        <item name="iconSize">24dp</item>
        <item name="iconTint">@color/yp_text_gray</item>
    </style>

    <style name="Switch" parent="Regular.16">
        <item name="thumbTint">@color/yp_text_gray</item>
        <item name="trackTint">@color/yp_light_gray</item>
    </style>

    <style name="EditTextSearch" parent="Regular.16">
        <item name="android:drawableTint">@color/yp_text_gray</item>
        <item name="android:textColorHint">@color/yp_text_gray</item>
    </style>

    <style name="SearchButtonTint">
        <item name="android:backgroundTint">@color/yp_light_gray</item>
    </style>

    <style name="ClearButtonTint">
        <item name="android:tint">@color/yp_text_gray</item>
    </style>

    <style name="ItemTrack">
        <item name="android:background">@color/yp_white</item>
    </style>

    <style name="DotTint">
        <item name="android:tint">@color/yp_text_gray</item>
    </style>

    <style name="ArrowTint">
        <item name="android:tint">@color/yp_text_gray</item>
    </style>

    <style name="SearchActivityButtons">
        <item name="android:textColor">@color/yp_white</item>
        <item name="android:backgroundTint">@color/yp_black</item>
        <item name="android:insetTop">@dimen/button_inset</item>
        <item name="android:insetBottom">@dimen/button_inset</item>
        <item name="android:paddingLeft">14dp</item>
        <item name="android:paddingRight">14dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:minHeight">36dp</item>
    </style>

    <style name="AudioPlayerButtons">
        <item name="android:buttonCornerRadius">999dp</item>
        <item name="android:backgroundTint">#C5C6C7</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingLeft">14dp</item>
        <item name="android:paddingRight">14dp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="iconGravity">top</item>
        <item name="iconSize">23dp</item>
        <item name="iconTint">@color/yp_white</item>
    </style>

    <style name="PlayButton">
        <item name="android:backgroundTint">@color/yp_black</item>
        <item name="iconTint">@color/yp_white</item>
    </style>

</resources>