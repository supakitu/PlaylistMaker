<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/ItemTrack"
    android:layout_width="match_parent"
    android:layout_height="@dimen/item_height"
    app:cardCornerRadius="0dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingHorizontal="@dimen/margin_horizontal">

        <ImageView
            android:id="@+id/image_artwork"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:layout_gravity="center|start"
            android:layout_weight="1"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:srcCompat="@drawable/ic_launcher_background" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/image_arrow"
            app:layout_constraintStart_toEndOf="@+id/image_artwork"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/tv_track_name"
                android:layout_width="wrap_content"
                android:layout_height="19dp"
                android:layout_marginStart="8dp"
                android:textAppearance="@style/YSRegular16"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="Yesterday (Remastered 2009)" />

            <TextView
                android:id="@+id/tv_artist_name"
                android:layout_width="wrap_content"
                android:layout_height="13dp"
                android:textAppearance="@style/YSRegular11"
                app:layout_constraintStart_toStartOf="@+id/tv_track_name"
                app:layout_constraintTop_toBottomOf="@+id/tv_track_name"
                tools:text="The Beatles" />

            <ImageView
                android:id="@+id/imageView"
                style="@style/DotTint"
                android:layout_width="13dp"
                android:layout_height="13dp"
                app:layout_constraintBottom_toBottomOf="@+id/tv_artist_name"
                app:layout_constraintStart_toEndOf="@+id/tv_artist_name"
                app:srcCompat="@drawable/icon_dot" />

            <TextView
                android:id="@+id/tv_track_time"
                android:layout_width="wrap_content"
                android:layout_height="13dp"
                android:textAppearance="@style/YSRegular11"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@+id/imageView"
                tools:text="5:03" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <ImageView
            android:id="@+id/image_arrow"
            style="@style/ArrowTint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/arrow_forward" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.cardview.widget.CardView>